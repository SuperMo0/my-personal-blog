{
  "name": "my-personal-blog",
  "version": "0.0.1",
  "private": true,
  "description": "My personal blog: an Express + Postgres API and a React SPA, sharing one deployed process.",
  "homepage": "https://github.com/SuperMo0/MyBlog-Deploy#readme",
  "bugs": {
    "url": "https://github.com/SuperMo0/MyBlog-Deploy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuperMo0/MyBlog-Deploy.git"
  },
  "license": "ISC",
  "author": "Mwafak",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "provision:accounts": "npm run provision:accounts --workspace=backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "biome ci .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
